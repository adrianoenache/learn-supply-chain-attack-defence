# Versões exatas sem ^ ou ~
save-exact=true

# Registry oficial fixo — impede redirect para mirror comprometido
registry=https://registry.npmjs.org/

# Audit automático em npm install, npm ci e npm audit fix.
# audit-level=high faz o comando falhar se CVEs de severidade alta ou crítica
# forem detectadas durante a instalação.
audit=true
audit-level=high

# Bloqueia scripts de ciclo de vida de pacotes (preinstall, install, postinstall).
# Lifecycle scripts são o principal vetor de supply chain attack
# (ex: event-stream em 2018, ua-parser-js em 2021).
#
# ATENÇÃO: ignore-scripts=true também bloqueia o preinstall do projeto raiz.
# Por isso `npm install <pacote>` direto NÃO dispara o check-package-age.js.
# Sempre use `npm run add` para adicionar dependências com as verificações de
# segurança. Pacotes que precisem de postinstall (ex: esbuild, sharp, canvas)
# devem ser rebuildados manualmente com:
#   npm_config_ignore_scripts=false npm rebuild <pacote>
ignore-scripts=true

# Bloqueia npm ci/install se Node.js ou npm não atender ao campo `engines` do package.json
engine-strict=true

# Idade mínima de release imposta pelo próprio npm (requer npm >= 11).
# O npm rejeita versões publicadas há menos de 7 dias, agindo como uma segunda
# camada além do check-package-age.js. Essa configuração também afeta
# `npm audit fix`, que pode falhar se o patch publicado for muito recente.
# Documentação: https://docs.npmjs.com/cli/v11/using-npm/config#min-release-age
min-release-age=7

# Lista de pacotes isentos da regra min-release-age (vazia por padrão).
# Use apenas temporariamente, por exemplo, para aplicar um patch crítico
# publicado há menos de 7 dias. Exemplo:
#   min-release-age-exclude[]=@myorg/shared-utils
#min-release-age-exclude=

# Instalação com lockfile congelado é garantida pelo uso de `npm ci` nos scripts
# (setup, npm-reinstall). O npm ci falha automaticamente se package-lock.json
# divergir do package.json — não é necessária configuração adicional aqui.
# NOTA: `prefer-frozen-lockfile` é uma opção do pnpm, não do npm.
