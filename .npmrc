# Pin exact versions without ^ or ~ operators.
save-exact=true

# Always generate a package-lock.json file.
# This makes the deterministic-install requirement explicit and protects
# against environments that might disable lock-file generation.
package-lock=true

# Fixed official registry — prevents redirect to a compromised mirror.
registry=https://registry.npmjs.org/

# Hide funding messages so security-related output stays readable.
fund=false

# Automatic audit during npm install, npm ci, and npm audit fix.
# audit-level=high makes the command fail if high or critical severity CVEs
# are detected during installation.
audit=true
audit-level=high

# Blocks package lifecycle scripts (preinstall, install, postinstall).
# Lifecycle scripts are the main vector for supply-chain attacks
# (e.g. event-stream in 2018, ua-parser-js in 2021).
#
# ATTENTION: ignore-scripts=true also blocks the root project's preinstall.
# Therefore, running `npm install <package>` directly does NOT trigger check-package-age.js.
# Always use `npm run add` to add dependencies with the security checks.
# Packages that need a postinstall to work (e.g. esbuild, sharp, canvas)
# must be rebuilt manually with:
#   npm_config_ignore_scripts=false npm rebuild <package>
ignore-scripts=true

# Blocks npm ci/install if Node.js or npm do not satisfy the `engines` field in package.json.
engine-strict=true

# Minimum release age enforced by npm itself (requires npm >= 11).
# npm rejects versions published less than 7 days ago, acting as a second
# layer beyond check-package-age.js. This setting also affects
# `npm audit fix`, which may fail if the published patch is too recent.
# Documentation: https://docs.npmjs.com/cli/v11/using-npm/config#min-release-age
min-release-age=7

# Optional dependencies are no longer globally omitted.
# Biome distributes its native CLI as platform-specific optional packages,
# which must be installed for lint/format scripts to work. Optional
# dependencies remain subject to min-release-age and audit-level=high,
# so the existing security gates still apply.
# Use only temporarily, for example, to apply a critical patch published
# less than 7 days ago. Example:
#   min-release-age-exclude[]=@myorg/shared-utils
#min-release-age-exclude=

# Frozen-lockfile installation is guaranteed by using `npm ci` in the scripts
# (setup, npm-reinstall). npm ci fails automatically if package-lock.json
# diverges from package.json — no additional configuration is needed here.
# NOTE: `prefer-frozen-lockfile` is a pnpm option, not an npm option.
