{
  "name": "learn-supply-chain-attack-defence",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Adriano Enache",
  "description": "Learn supply chain attack defence",
  "homepage": "https://github.com/adrianoenache/learn-supply-chain-attack-defence#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianoenache/learn-supply-chain-attack-defence.git"
  },
  "bugs": {
    "url": "https://github.com/adrianoenache/learn-supply-chain-attack-defence/issues"
  },
  "keywords": [
    "supply-chain",
    "security",
    "npm",
    "nodejs",
    "defense-in-depth",
    "biome",
    "husky"
  ],
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=11.17.0"
  },
  "pkgAgeCheck": {
    "minAgeDays": 7
  },
  "updateCheck": {
    "minAgeDays": 7,
    "remindEveryDays": 1,
    "alwaysRemind": false,
    "includeTransitive": false,
    "registryTimeoutMs": 10000,
    "cacheTtlHours": 24,
    "historyMaxEntries": 30,
    "stuckInQuarantineThreshold": 3,
    "highReleaseCadenceDays": 7
  },
  "typosquattingCheck": {
    "cacheTtlHours": 24,
    "maxResponseMB": 1,
    "timeoutMs": 10000,
    "retryMaxAttempts": 1,
    "retryInitialDelayMs": 250,
    "retryBackoffMultiplier": 2,
    "retryMaxDelayMs": 1000
  },
  "licensesCheck": {
    "allowed": [
      "MIT",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "ISC",
      "0BSD"
    ],
    "prohibited": [
      "GPL-1.0",
      "GPL-2.0",
      "GPL-3.0",
      "AGPL-1.0",
      "AGPL-3.0",
      "LGPL-2.0",
      "LGPL-2.1",
      "LGPL-3.0",
      "MPL-1.0",
      "MPL-1.1",
      "MPL-2.0",
      "UNLICENSED"
    ],
    "failOnUnknown": false
  },
  "checkMdLinks": {
    "ignoredDirs": ["node_modules", ".git"],
    "cacheTtlHours": 24,
    "cacheFile": ".md-links-cache.json"
  },
  "lifecycleScriptAnalysis": {
    "enabled": true,
    "failOn": "high"
  },
  "trustReport": {
    "enabled": true,
    "failOnMinScore": false,
    "minScore": 60,
    "concurrency": 10,
    "registryTimeoutMs": 10000,
    "cacheTtlHours": 24,
    "outputFile": "trust-report.md",
    "scoringWeights": {
      "age": 20,
      "cadence": 10,
      "downloads": 15,
      "maintainers": 10,
      "provenance": 15,
      "typosquatting": 10,
      "lifecycleRisk": 15,
      "license": 5
    }
  },
  "defences": {
    "typosquattingThreshold": 2,
    "internalPackageNames": [],
    "provenanceMode": "warn",
    "huskyPreCommitHash": "2b594b324a64c3d3f8ea22a878e89ff7565f824e806d080d60ad2a9f6f6ce6e6"
  },
  "scripts": {
    "defence:add": "node ./tools/add-package.js",
    "defence:analyze-lifecycle-scripts": "node ./tools/analyze-lifecycle-scripts.js",
    "defence:trust-report": "node ./tools/generate-trust-report.js",
    "defence:trust-report:json": "node ./tools/generate-trust-report.js --format=json",
    "defence:trust-report:fail": "node ./tools/generate-trust-report.js --fail",
    "defence:bootstrap": "node ./tools/setup-bootstrap.js",
    "defence:check-engines": "node ./tools/check-engines.js",
    "defence:check-lockfile-integrity": "node ./tools/check-lockfile-integrity.js",
    "defence:check-hooks": "node ./tools/check-hooks.js",
    "defence:check-secrets": "node ./tools/check-secrets.js",
    "defence:check-md-links": "node ./tools/check-md-links.js",
    "defence:license-check": "node ./tools/check-licenses.js",
    "defence:license-check:fail": "node ./tools/check-licenses.js --fail",
    "defence:license-check:json": "node ./tools/check-licenses.js --format=json",
    "defence:pkg-age-check": "node ./tools/check-package-age.js",
    "defence:audit": "node ./tools/run-audit-with-retry.js",
    "defence:pre-commit": "npm audit signatures && npm run defence:audit && npm run defence:update-check",
    "defence:reinstall": "npm run defence:check-engines && npm run defence:pkg-age-check && rm -rf node_modules && npm cache clean --force && npm ci && npm audit signatures && npm run prepare && node ./tools/check-package-age.js --transitive && npm audit fix && node ./tools/check-package-age.js --transitive && npm outdated",
    "defence:update": "node ./tools/update-packages.js",
    "defence:update:interactive": "node ./tools/update-packages.js --interactive",
    "defence:update:interactive:dry-run": "node ./tools/update-packages.js --interactive --dry-run",
    "defence:update-badge": "node ./tools/update-badge.js",
    "defence:update-badge:dry-run": "node ./tools/update-badge.js --dry-run",
    "defence:update-check": "node ./tools/check-updates.js",
    "defence:update-check:force": "node ./tools/check-updates.js --force",
    "defence:update-check:json": "node ./tools/check-updates.js --format=json",
    "defence:update-check:offline": "node ./tools/check-updates.js --offline",
    "defence:perf": "node ./tools/perf/benchmark.js",
    "defence:perf:baseline": "node ./tools/perf/benchmark.js --save-baseline",
    "defence:perf:check-package-age": "node ./tools/perf/benchmark.js --tool=check-package-age",
    "defence:perf:check-updates": "node ./tools/perf/benchmark.js --tool=check-updates",
    "defence:sync-check": "node ./tools/check-sync.js",
    "defence:sync-check:fix": "node ./tools/check-sync.js --fix",
    "defence:verify-defences": "node ./tools/verify-defences.js",
    "defence:verify-defences:fix": "node ./tools/install-defences.js --update-local-manifest",
    "defence:generate-sbom": "node ./tools/generate-sbom.js",
    "format": "biome format --write tools/",
    "lint:fix": "biome check --write tools/",
    "lint": "biome check tools/",
    "prepare": "husky",
    "setup": "npm run defence:check-engines && npm run defence:pkg-age-check && npm ci && npm audit signatures && npm run prepare",
    "test": "node --test tools/*.test.js tools/lib/*.test.js tools/perf/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test tools/*.test.js tools/lib/*.test.js tools/perf/*.test.js",
    "test:e2e": "RUN_E2E_TESTS=true node --test tools/e2e/*.test.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "husky": "9.1.7"
  }
}
