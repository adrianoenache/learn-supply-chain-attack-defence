{
  "name": "learn-supply-chain-attack-defence",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Adriano Enache",
  "description": "Learn supply chain attack defence",
  "homepage": "https://github.com/adrianoenache/learn-supply-chain-attack-defence#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianoenache/learn-supply-chain-attack-defence.git"
  },
  "bugs": {
    "url": "https://github.com/adrianoenache/learn-supply-chain-attack-defence/issues"
  },
  "keywords": [
    "supply-chain",
    "security",
    "npm",
    "nodejs",
    "defense-in-depth",
    "biome",
    "husky"
  ],
  "engines": {
    "node": ">=24.16.0",
    "npm": ">=11.13.0"
  },
  "pkgAgeCheck": {
    "minAgeDays": 7
  },
  "updateCheck": {
    "minAgeDays": 7,
    "remindEveryDays": 1,
    "alwaysRemind": false,
    "includeTransitive": false,
    "registryTimeoutMs": 10000,
    "cacheTtlHours": 24
  },
  "licensesCheck": {
    "allowed": [
      "MIT",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "ISC",
      "0BSD"
    ],
    "prohibited": [
      "GPL-1.0",
      "GPL-2.0",
      "GPL-3.0",
      "AGPL-1.0",
      "AGPL-3.0",
      "LGPL-2.0",
      "LGPL-2.1",
      "LGPL-3.0",
      "MPL-1.0",
      "MPL-1.1",
      "MPL-2.0",
      "UNLICENSED"
    ],
    "failOnUnknown": false
  },
  "scripts": {
    "defence:add": "node ./tools/add-package.js",
    "defence:bootstrap": "node ./tools/setup-bootstrap.js",
    "defence:check-md-links": "node ./tools/check-md-links.js",
    "defence:license-check": "node ./tools/check-licenses.js",
    "defence:license-check:fail": "node ./tools/check-licenses.js --fail",
    "defence:license-check:json": "node ./tools/check-licenses.js --format=json",
    "defence:pkg-age-check": "node ./tools/check-package-age.js",
    "defence:pre-commit": "npm audit signatures && npm audit --audit-level=high && npm run defence:update-check",
    "defence:reinstall": "node --version && npm --version && npm run defence:pkg-age-check && rm -rf node_modules && npm cache clean --force && npm ci && npm audit signatures && npm run prepare && node ./tools/check-package-age.js --transitive && npm audit fix && node ./tools/check-package-age.js --transitive && npm outdated",
    "defence:update": "node ./tools/update-packages.js",
    "defence:update-check": "node ./tools/check-updates.js",
    "defence:update-check:force": "node ./tools/check-updates.js --force",
    "defence:update-check:json": "node ./tools/check-updates.js --format=json",
    "defence:sync-check": "node ./tools/check-sync.js",
    "defence:sync-check:fix": "node ./tools/check-sync.js --fix",
    "format": "biome format --write tools/",
    "lint:fix": "biome check --write tools/",
    "lint": "biome check tools/",
    "prepare": "husky",
    "setup": "node --version && npm --version && npm run defence:pkg-age-check && npm ci && npm audit signatures && npm run prepare",
    "test": "node --test tools/*.test.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "husky": "9.1.7"
  }
}
